# S11 — a deleted work.db is fully rebuilt from the canonical snapshots
# (active *and* archived), reproducing the classification and recency order
# byte-for-byte and modifying zero snapshots. Covers US3 #1, #3; SC-006;
# FR-022, FR-025.

gitrepo src
env WS=$WORK/ws

seedworks src alpha bravo charlie
activeorder charlie bravo alpha

# Archive one Work so the rebuild has an archived snapshot to classify too.
workid $WS/in-progress/src_bravo/work-state.json ID_BRAVO
work archive $ID_BRAVO --yes
stdout 'archived 1 of 1'
activeorder charlie alpha

# Fingerprint every snapshot and the whole index order before the DB is lost.
snapsums before-sums
dborder before-order

rm $WORK_HOME/state/work.db

# Any F2 command triggers the rebuild; `work resume` with no target on a
# non-tty then exits 2, which is fine — the rebuild already ran.
! work resume
stderr '^error: usage: '

snapsums after-sums
dborder after-order
cmp before-sums after-sums
cmp before-order after-order
dbuserversion 2

# resume / archive behave exactly as before: same active set, same order.
activeorder charlie alpha
dbcount 3
