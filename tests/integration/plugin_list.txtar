# `work plugin list [--json]`: empty before any install, populated after,
# sorted by marketplace then plugin, and pure (never mutates).

# Empty before any install; the pure read must not create a Work home.
work plugin list
! stdout .
work plugin list --json
stdout '"installed": \[\]'
stdout '"available": \[\]'
stdout '"catalog_errors": \[\]'
! exists $WORK_HOME

# After installing two packages from different marketplaces, list is sorted by
# marketplace and shows full provider references for every contribution.
preparepluginfixture colliding-starter ZEBRA
installplugin zebra $ZEBRA
preparepluginfixture specific-starter APPLE
installplugin apple $APPLE

work plugin list
stdout '(?m)^specific-starter@apple  local  '
stdout '(?m)^colliding-starter@zebra  local  '
stdout '  specific-starter \(starter\)'

work plugin list --json
stdout '"id": "specific-starter@apple"'
stdout '"id": "colliding-starter@zebra"'
stdout '"marketplace": "apple"'
stdout '"source_kind": "local"'
stdout '"specific-starter@apple/gitflow"'
! stdout '"alias"'
! stdout '"origin"'

# Purity: list never mutates the registry.
cp $WORK_HOME/state/registry.json before.json
work plugin list
work plugin list --json
cmp $WORK_HOME/state/registry.json before.json
