# Package toggles keep exact policy membership and convention memory.
preparepluginfixture admin-suite SOURCE
installplugin outside $SOURCE
installplugin ordered $SOURCE
work repository policy add admin-suite@ordered/clone
stdout '^work: policy now admin-suite@ordered/clone$'
cp $WORK_HOME/config/work.json before.json
work plugin disable admin-suite@ordered admin-suite@ordered
stdout '^work: disabled admin-suite@ordered$'
work plugin list --json
stdout '"enabled": false'
stdout '"version": "release-blue"'
work repository policy list --json
stdout '"unavailable_reason": "package-disabled"'
work plugin enable admin-suite@ordered
stdout '^work: enabled admin-suite@ordered$'
cmp $WORK_HOME/config/work.json before.json
work plugin disable admin-suite@outside
cmp $WORK_HOME/config/work.json before.json
cp $WORK_HOME/state/registry.json registry-before.json
! work plugin disable admin-suite@ordered missing@ordered
stderr '^error: usage:'
cmp $WORK_HOME/state/registry.json registry-before.json
! work plugin enable admin-suite@ordered --json
stderr '^error: usage:'
cmp $WORK_HOME/state/registry.json registry-before.json
# A bare name is not an address: there is no global alias.
! work plugin disable admin-suite
stderr '^error: usage:'
cmp $WORK_HOME/state/registry.json registry-before.json
