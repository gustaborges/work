# S12 — a stale / inconsistent index is reconciled back into agreement with the
# snapshots on the next command, without any snapshot being rewritten.
# Covers US3 #2; FR-023.

gitrepo src
env WS=$WORK/ws

seedworks src alpha bravo
activeorder bravo alpha

workid $WS/in-progress/src_alpha/work-state.json ID_ALPHA
workid $WS/in-progress/src_bravo/work-state.json ID_BRAVO

snapsums before-sums

# Corrupt the index three ways, touching no snapshot:
#  - bravo's row (the most recent) is dragged into the past, so the index now
#    sorts alpha ahead of bravo, disagreeing with the snapshots
#  - a ghost row is added whose snapshot does not exist on disk
#  - alpha's real row is deleted
dbstale $ID_BRAVO 2000-01-01T00:00:00Z
activeorder alpha bravo
dbghost 01GHOST00000000000000000000
dbdroprow $ID_ALPHA

# Any command triggers the reconcile pass.
! work resume
stderr '^error: usage: '

# bravo's last_accessed_at is restored from its snapshot, so it out-sorts the
# re-added alpha row again; alpha's row is back; the ghost row is dropped.
activeorder bravo alpha
dbhasrow $ID_ALPHA
! dbhasrow 01GHOST00000000000000000000
dbcount 2

# No snapshot file was modified.
snapsums after-sums
cmp before-sums after-sums
