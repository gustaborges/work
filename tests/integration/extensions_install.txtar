# Installed packages keep every Importer/Linker declaration in the registry.

# context-suite is installed and every declaration reaches the registry.
preparepluginfixture context-suite SUITE
installplugin suite $SUITE
grep '"key": "github.pull_request"' $WORK/dothome/state/registry.json
grep '"automatic": true' $WORK/dothome/state/registry.json
grep '"event": "start:finalized"' $WORK/dothome/state/registry.json
grep '"display_name": "Context Importer"' $WORK/dothome/state/registry.json
grep '"work:start_mode:optional"' $WORK/dothome/state/registry.json
grep '"install_mode": "copy"' $WORK/dothome/state/registry.json
grep '"marketplace_name": "suite"' $WORK/dothome/state/registry.json

# `work plugin list` shows identity, source kind and components only.
work plugin list
stdout 'context-suite@suite  local'
stdout 'importer2 \(importer\)'
! stdout 'start:finalized'
! stdout 'inputs'

# A restriction to a Starter that is not installed still installs.
preparepluginfixture restricted-suite RESTRICTED
installplugin suite $RESTRICTED
work plugin list
stdout 'restricted-suite@suite'

# The managed copy is independent of the author's source directory.
exists $WORK_HOME/plugins/suite/context-suite/source/plugin.json
exists $WORK_HOME/plugins/suite/context-suite/.install-meta.json
rm $SUITE
exists $WORK_HOME/plugins/suite/context-suite/source/plugin.json

# An interpreted Starter with no exec bit runs through its runtime.
[!exec:sh] skip 'no sh'
[windows] skip 'runtime-sh is Unix-only'
preparepluginfixture runtime-sh SH
installplugin suite $SH
gitrepo src/runtime-sh-repo
work-set-roots $WORK/dothome/config/work.json $WORK/src
work start demo-sh-1 --workspace $WORK/ws --base main --slug via-sh --prefix {slug} --yes
stdout 'work: created [0-9A-HJKMNP-TV-Z]{26}'
grep '"starter": "runtime-sh@suite/starter"' $WORK/ws/in-progress/runtime-sh-repo_via-sh/work-state.json
