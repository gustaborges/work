# Manual association is exact, value-free, and never launches the provider.
env WS=$WORK/workspace
mkdir $WS
gitrepo src
exec work start $WORK/src --workspace $WS --base main --slug topic --prefix '{slug}' --yes
preparepluginfixture manual-suite PKG
installplugin manual $PKG
env WORK_FIXTURE_LOG=$WORK/launches.jsonl
workid $WS/in-progress/src_topic/work-state.json ID
cd $WS/in-progress/src_topic/worktree
exec work link manual-suite@manual/linker ' exact $literal; value '
stdout '^work: linked .* github.pull_request manual-suite@manual/linker\n$'
! stdout 'literal'
! stderr .
exec work status --json
stdout '"github.pull_request":" exact \$literal; value "'
! exists $WORK/launches.jsonl
exec work link linker -- --leading-dash
exec work status --json
stdout '"github.pull_request":"--leading-dash"'
! exec work link manual-suite@manual/linker ''
stderr 'usage'
! stdout .
! exec work link
stderr 'usage'
! exec work link manual-suite@manual/linker
stderr 'usage'
! exec work link manual-suite@manual/linker value --json=false
stderr 'usage'
! exec work link manual-suite@manual/importer value
stderr 'manual-component-unavailable'
cd $WORK
installplugin alternate $PKG
cd $WS/in-progress/src_topic/worktree
! exec work link linker value
stderr 'manual-component-ambiguous'
stderr 'manual-suite@alternate/linker, manual-suite@manual/linker'
exec work link manual-suite@alternate/linker replacement
stdout 'github.pull_request manual-suite@alternate/linker'
! exists $WORK/launches.jsonl
cd $WORK
! exec work link manual-suite@manual/linker value
stderr 'target-not-found'
! stdout .
exec work archive $ID --yes
today TODAY
cd $WS/archived/$TODAY-src_topic
! exec work link manual-suite@manual/linker value
stderr 'target-archived'
! stdout .
