# F5 — context published and discovered when a Work starts (quickstart S4-S14).
# The first start persists the workspace, so later starts omit --workspace.

preparepluginfixture context-suite SUITE
work plugin install $SUITE
preparepluginfixture restricted-suite RESTRICTED
work plugin install $RESTRICTED
gitrepo src/demo-ctx-1
work-set-roots $WORK/dothome/config/work.json $WORK/src
env WS=$WORK/ws
env WORK_FIXTURE_LOG=$WORK/launches.log

# S4: with no published context the snapshot holds empty objects and no provenance.
# (Linkers and Importers are silenced so only the Starter's context is observed.)
env WORK_FIXTURE_MODE=linker-none,linker2-none,importer-empty,importer2-empty
work start demo-ctx-1 --workspace $WS --base main --slug plain --prefix {slug} --yes
stdout 'work: created [0-9A-HJKMNP-TV-Z]{26}'
grep '"schema": 3' $WS/in-progress/demo-ctx-1_plain/work-state.json
grep '"meta": \{\}' $WS/in-progress/demo-ctx-1_plain/work-state.json
grep '"links": \{\}' $WS/in-progress/demo-ctx-1_plain/work-state.json
provenancecount 0

# S4: a Starter that publishes context lands it in the first snapshot, with provenance.
env WORK_FIXTURE_MODE=starter-context,linker-none,linker2-none,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug ctx --prefix {slug} --yes
grep '"github.pull_request.number": 212' $WS/in-progress/demo-ctx-1_ctx/work-state.json
grep '"github.pull_request": "https://example.test/pr/212"' $WS/in-progress/demo-ctx-1_ctx/work-state.json
provenance links github.pull_request context-suite/starter start
provenance meta github.pull_request.number context-suite/starter start
provenancecount 2
verifycoherent

# S5: an invalid or foreign key fails before anything is created (exit 37).
env WORK_FIXTURE_MODE=starter-bad-key
! work start demo-ctx-1 --base main --slug badkey --prefix {slug} --yes
stderr 'error: starter-response-invalid: .*"GitHub.PR"'
! exists $WS/in-progress/demo-ctx-1_badkey
exec git -C $WORK/src/demo-ctx-1 branch --list badkey
! stdout .

env WORK_FIXTURE_MODE=starter-foreign-private
! work start demo-ctx-1 --base main --slug foreign --prefix {slug} --yes
stderr 'error: starter-response-invalid: .*plugin.someone-else.x'
! exists $WS/in-progress/demo-ctx-1_foreign
exec git -C $WORK/src/demo-ctx-1 branch --list foreign
! stdout .
provenancecount 2

# S6: a Linker's value becomes the link, replacing the Starter's, with discover
# provenance. Stdout is only the three stable lines; progress is on the UI channel.
env WORK_FIXTURE_MODE=starter-context,linker-value,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug found --prefix {slug} --yes
stdout 'work: created '
stdout 'work: branch found '
stdout 'work: path '
! stdout 'running'
! stdout 'linked'
stderr 'work: running context-suite/linker \(discover\)'
stderr 'work: context-suite/linker: linked github.pull_request'
! stderr 'example.test'
grep '"github.pull_request": "https://example.test/pr/212-from-linker"' $WS/in-progress/demo-ctx-1_found/work-state.json
provenance links github.pull_request context-suite/linker discover

# S6: a Linker with nothing to report is silent; an empty value is a warning and stores nothing.
env WORK_FIXTURE_MODE=linker-none,linker2-none,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug nothing --prefix {slug} --yes
! stderr 'linked'
! stderr 'warning:'
grep '"links": \{\}' $WS/in-progress/demo-ctx-1_nothing/work-state.json

env WORK_FIXTURE_MODE=linker-empty-value,linker2-none,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug emptyval --prefix {slug} --yes
stderr 'warning: extension-response-invalid: context-suite/linker \(discover\) for Work [0-9A-HJKMNP-TV-Z]{26}:'
grep '"links": \{\}' $WS/in-progress/demo-ctx-1_emptyval/work-state.json

# S7: components that are not eligible are never started, and an eligible one is
# sent exactly its declared inputs.
rm $WORK/launches.log
env WORK_FIXTURE_MODE=linker-none,linker2-none,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug launches --prefix {slug} --yes
! grep 'linker-other-starter' $WORK/launches.log
! grep 'linker-not-automatic' $WORK/launches.log
! grep 'linker-unsubscribed' $WORK/launches.log
! grep 'importer-missing-link' $WORK/launches.log
! grep 'importer-manual-only' $WORK/launches.log
grep '"role":"linker","stdin":\{"inputs":\{"worktree_path":"[^"]*"\}\}\}' $WORK/launches.log
! grep 'starters' $WORK/launches.log
! grep 'work-state.json' $WORK/launches.log

# S8: two Linkers sharing a key resolve by name order: linker2 runs after linker
# and its value is stored, with provenance naming it.
env WORK_FIXTURE_MODE=linker-value,linker2-value,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug order --prefix {slug} --yes
stderr 'running context-suite/linker \(discover\)(.|\n)*running context-suite/linker2 \(discover\)'
grep '"github.pull_request": "https://example.test/pr/212-from-linker2"' $WS/in-progress/demo-ctx-1_order/work-state.json
provenance links github.pull_request context-suite/linker2 discover

# S14: the same lines appear in every mode; with NO_COLOR/TERM=dumb or redirected
# streams there are no control sequences, and extension output never reaches stdout.
env NO_COLOR=1 TERM=dumb
env WORK_FIXTURE_MODE=linker-value,importer-ok,importer2-exit1
work start demo-ctx-1 --base main --slug plainui --prefix {slug} --yes
stderr 'work: running context-suite/linker \(discover\)'
stderr 'work: context-suite/importer: imported 2 item\(s\)'
stderr 'warning: extension-failed: context-suite/importer2 \(import\)'
cp stderr plainui.err
! grep '\x1b' plainui.err
! stdout 'running'
! stdout 'warning'
! stdout 'imported'
env NO_COLOR=
env TERM=

# S12: every failure class is exactly one warning; the Work is intact, the start
# still succeeds and prints the three stable lines, and healthy siblings ran.
env WORK_FIXTURE_MODE=linker-exit1,linker2-value,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug fexit --prefix {slug} --yes
stdout 'work: created '
stdout 'work: path '
stderr -count=1 'warning:'
stderr 'warning: extension-failed: context-suite/linker \(discover\) for Work [0-9A-HJKMNP-TV-Z]{26}:'
stderr 'context-suite/linker2: linked github.pull_request'
exists $WS/in-progress/demo-ctx-1_fexit/worktree
grep '"schema": 3' $WS/in-progress/demo-ctx-1_fexit/work-state.json
grep 'from-linker2' $WS/in-progress/demo-ctx-1_fexit/work-state.json
! grep 'from-linker"' $WS/in-progress/demo-ctx-1_fexit/work-state.json

env WORK_FIXTURE_MODE=linker-garbage,linker2-none,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug fgarbage --prefix {slug} --yes
stderr -count=1 'warning:'
stderr 'warning: extension-response-invalid: context-suite/linker \(discover\)'
grep '"links": \{\}' $WS/in-progress/demo-ctx-1_fgarbage/work-state.json

env WORK_FIXTURE_MODE=linker-value,importer-exit1,importer2-empty
work start demo-ctx-1 --base main --slug iexit --prefix {slug} --yes
stderr -count=1 'warning:'
stderr 'warning: extension-failed: context-suite/importer \(import\)'
! exists $WS/in-progress/demo-ctx-1_iexit/notes

env WORK_FIXTURE_MODE=linker-value,importer-garbage,importer2-empty
work start demo-ctx-1 --base main --slug igarbage --prefix {slug} --yes
stderr -count=1 'warning:'
stderr 'warning: extension-response-invalid: context-suite/importer \(import\)'

# Without WORK_DEBUG neither the extension's own text nor a value reaches a warning.
env WORK_FIXTURE_MODE=linker-exit1,linker2-none,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug quietfail --prefix {slug} --yes
! stderr 'simulated failure'
! stderr 'exit status'

# WORK_DEBUG adds the exit status and the stderr tail after the human line.
env WORK_DEBUG=1
work start demo-ctx-1 --base main --slug debugfail --prefix {slug} --yes
stderr 'exit status: 1'
stderr 'simulated failure'
env WORK_DEBUG=

# A linked package whose entrypoint vanished: a start failure warning, the
# installation itself stays valid.
work plugin install $SUITE --link
[!windows] rm $SUITE/linker
[windows] rm $SUITE/linker.exe
env WORK_FIXTURE_MODE=linker2-none,importer-empty,importer2-empty
work start demo-ctx-1 --base main --slug gone --prefix {slug} --yes
stderr -count=1 'warning:'
stderr 'warning: extension-start-failed: context-suite/linker \(discover\)'
exists $WS/in-progress/demo-ctx-1_gone/worktree
work plugin list
stdout 'context-suite  local-linked'
