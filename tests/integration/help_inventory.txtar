# Q9, Q10 — `work --help` is grouped, inventory-driven, plain when piped, and
# exits 0 in every mode. testscript drives `work` with non-TTY streams, so this
# is the piped form. Covers US2; FR-020, FR-021; SC-005, SC-007.

# Exit 0, brand header + tagline, no ANSI escapes.
work --help
stdout 'WORK'
stdout 'Isolated work, ready when you are\.'
! stdout '\x1b'

# The Daily Commands group lists exactly start, resume, archive.
stdout '(?m)^Daily Commands:$'
stdout '(?m)^  archive '
stdout '(?m)^  resume '
stdout '(?m)^  start '

# The Setup group lists shell-init and completion.
stdout '(?m)^Setup:$'
stdout '(?m)^  shell-init '
stdout '(?m)^  completion '

# F3: Administration lists `repository`, appearing once.
stdout '(?m)^Administration:$'
stdout '(?m)^  repository '
stdout -count=1 'repository  '

# F4: `plugin` and `convention` each appear exactly once, also under
# Administration.
stdout '(?m)^  plugin '
stdout -count=1 '(?m)^  plugin '
stdout '(?m)^  convention '
stdout -count=1 '(?m)^  convention '

# F6 status is discoverable inside a Work.
stdout 'Inside a Work'
stdout -count=1 '(?m)^  status '

# The footer and usage line are present.
stdout '(?m)^Usage:$'
stdout 'work \[command\] --help'

# `-h` and `work help` are equivalent and also exit 0.
work -h
stdout '(?m)^Daily Commands:$'
work help
stdout '(?m)^Daily Commands:$'

work status --help
stdout 'status \[WORK\]'
stdout '--json'

work --help
stdout -count=1 '(?m)^  link '
work link --help
stdout 'link \[LINKER\] \[VALUE\]'
! stdout '\-\-json'
! stdout '\-\-yes'

work --help
stdout -count=1 '(?m)^  import '
work import --help
stdout 'import \[IMPORTER\]'
! stdout '\-\-json'
! stdout '\-\-yes'

# F7 complete administrative direct inventory and automation flags.
work plugin --help
stdout 'install'
stdout 'enable'
stdout 'disable'
stdout 'update'
stdout 'uninstall'
work plugin install --help
stdout '.*--embedded'
stdout '.*--link'
stdout '.*--as'
work plugin update --help
stdout '.*--check'
stdout '.*--all'
stdout '.*--yes'
stdout '.*--remove-policy-references'
work plugin uninstall --help
stdout '.*--yes'
stdout '.*--remove-policy-references'
work repository policy --help
stdout 'add'
stdout 'remove'
stdout 'move'
stdout 'replace'
work repository root --help
stdout 'list'
stdout 'add'
stdout 'remove'
stdout 'replace'
work convention --help
stdout 'show'
stdout 'set'
