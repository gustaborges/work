# F7: bare repository is an interactive hub; redirected invocation gives
# direct guidance, while --help retains the discoverable command inventory.

! work repository
stderr 'error: usage:'
! stdout '\x1b'

work repository --help
stdout 'locator'
stdout 'policy'
stdout 'root'

work --help
stdout '(?m)^Administration:$'
stdout '(?m)^  repository  '

! work repository --json
stderr 'error: usage:'
